<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--Permisos-->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--Cámara opcional-->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UEBank">

        <!--Pantallas-->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.UEBank.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PanelPrincipalActivity"
            android:exported="false" />

        <activity
            android:name=".PerfilActivity"
            android:exported="false" />

        <activity
            android:name=".BeneficiariosActivity"
            android:exported="false" />

        <activity
            android:name=".CuentasActivity"
            android:exported="false" />

        <activity
            android:name=".MovimientosActivity"
            android:exported="false" />

        <activity
            android:name=".MetasActivity"
            android:exported="false" />

    </application>

</manifest>
